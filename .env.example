# Copy to .env for local development. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-random-key-for-deployment
DJANGO_REQUIRE_SECRET=false
ENABLE_DEMO=true
OSRM_BASE_URL=https://router.project-osrm.org
WEATHER_BASE_URL=https://api.open-meteo.com
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
PROVIDER_USER_AGENT=WeatherAwareAssessment/1.0
# Only when the hosting reverse proxy strips and sets X-Forwarded-Proto:
TRUST_PROXY=false
SECURE_SSL_REDIRECT=false
PORT=8000
